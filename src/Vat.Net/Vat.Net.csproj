<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Vat</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Vat.Net</PackageId>
    <Version>0.1.0</Version>
    <Title>Vat.NET</Title>
    <Authors>Israel Iyonsi</Authors>
    <Copyright>Copyright (c) 2026 Israel Iyonsi</Copyright>
    <Description>Validate EU and UK VAT registration numbers offline: per-country format and check-digit verification without calling VIES. Zero dependencies, ISO 7064 and Luhn checksums for the countries that define them.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/IsraelIyonsi/Vat.NET</RepositoryUrl>
    <PackageProjectUrl>https://github.com/IsraelIyonsi/Vat.NET</PackageProjectUrl>
    <PackageTags>vat;vatin;tax;eu;uk;vies;validation;checksum;compliance;invoicing</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/IsraelIyonsi/Vat.NET/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vat.Net.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
